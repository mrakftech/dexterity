@using Domain.Entities.UserAccounts
@using Services.Features.Appointments.Dtos
@using Services.Features.PatientManagement.Dtos.Details
@using Services.Features.Settings.Dtos
@using Services.Features.UserAccounts.Dtos.User
@if (!_loadScreen)
{
	<DexDialog>
		<DialogTitle>
			@_title
		</DialogTitle>
		<Content>
			<MudItem>
				<CascadingValue Value="AppointmentData.PatientId" Name="PatientId">
					<PatientAlertBar AlertType="@nameof(AlertType.Appointment)"/>
				</CascadingValue>
			</MudItem>
			<DexForm Model="@AppointmentData" OnValidSubmit="SaveAppointment" ColumnCount="2">
				<Fields>
					<FormItem Field="@nameof(UpsertAppointmentDto.PatientId)" ColumnSpan="2">
						<Template>
							<PatientAutoComplete PatientList="PatientList" OnChangePatient="ChangePatient"
							                     SelectedPatientName="@SelectedPatientName"></PatientAutoComplete>
						</Template>
					</FormItem>
					<FormItem Field="@nameof(UpsertAppointmentDto.StartTime)" ColumnSpan="1">
						<Template>
							<label class="e-form-label">Start Time:</label>
							<SfDateTimePicker Min="@MinDate" TValue="DateTime" Value="@AppointmentData.StartTime"
							                  MinTime="@MinTime" MaxTime="@MaxTime" Step="15">
								<DateTimePickerEvents TValue="DateTime" ValueChange="@OnChange">
								</DateTimePickerEvents>
							</SfDateTimePicker>
						</Template>
					</FormItem>
					<FormItem Field="@nameof(UpsertAppointmentDto.AppointmentTypeId)" ColumnSpan="1">
						<Template>
							<label class="e-form-label">Appointment Type:</label>
							<SfDropDownList TValue="Guid" TItem="AppointmentTypeDto" Placeholder="Select type"
							                DataSource="@AppointmentTypes"
							                @bind-Value="@AppointmentData.AppointmentTypeId">
								<DropDownListFieldSettings Value="Id" Text="Name"></DropDownListFieldSettings>
								<DropDownListEvents TValue="Guid" TItem="AppointmentTypeDto"
								                    ValueChange="OnAppointmentTypeChanged"></DropDownListEvents>
							</SfDropDownList>
						</Template>
					</FormItem>
					<FormItem Field="@nameof(UpsertAppointmentDto.ClinicId)" ColumnSpan="1">
						<Template>
							<label class="e-form-label">Clinics:</label>
							<SfDropDownList TValue="int" TItem="UserClinic" Placeholder="Select Clinic"
							                DataSource="@Clinics" @bind-Value="@AppointmentData.ClinicId">
								<DropDownListFieldSettings Value="ClinicId"
								                           Text="Clinic.Name"></DropDownListFieldSettings>
								<DropDownListEvents TValue="int" TItem="UserClinic"
								                    ValueChange="OnClinicChanged"></DropDownListEvents>
							</SfDropDownList>
						</Template>
					</FormItem>
					<FormItem Field="@nameof(UpsertAppointmentDto.ClinicSiteId)" ColumnSpan="1">
						<Template>
							<label class="e-form-label">Site Or Room:</label>
							<SfDropDownList TValue="Guid" TItem="ClinicSiteDto" Placeholder="Select Site"
							                DataSource="@ClinicSites" @bind-Value="@AppointmentData.ClinicSiteId">
								<DropDownListFieldSettings Value="Id" Text="Name"></DropDownListFieldSettings>
							</SfDropDownList>
						</Template>
					</FormItem>
					<FormItem Field="@nameof(UpsertAppointmentDto.HcpId)" ColumnSpan="1">
						<Template>
							<label class="e-form-label">HCP:</label>
							<SfDropDownList TValue="Guid" TItem="HealthcareDto" Placeholder="Select Hcp"
							                DataSource="@HealthCares" @bind-Value="@AppointmentData.HcpId">
								<DropDownListFieldSettings Value="Id" Text="Name"></DropDownListFieldSettings>
							</SfDropDownList>
						</Template>
					</FormItem>
					<FormItem Field="@nameof(UpsertAppointmentDto.Duration)" ColumnSpan="1">
						<Template>
							<label class="e-form-label">Duration:</label>
							<SfNumericTextBox TValue="int" Value=@AppointmentData.Duration
							                  Min="@AppointmentConstants.AppointmentInterval"
							                  Step="@AppointmentConstants.AppointmentInterval"
							                  Max="60"></SfNumericTextBox>
						</Template>
					</FormItem>
					<FormItem Field="@nameof(UpsertAppointmentDto.Description)" ColumnSpan="2">
						<Template>
							<label class="e-form-label">Description:</label>
							<SfTextBox @bind-Value="@AppointmentData.Description" Multiline></SfTextBox>
						</Template>
					</FormItem>
				</Fields>
				<Buttons>
					<DexLoadingButton Name="Save Appointment" Type="MudButtonType.Submit" Processing="_processing"
					                  Icon="fas fa-floppy-disk"></DexLoadingButton>
				</Buttons>
			</DexForm>
		</Content>
		<ActionButtons>
			@if (Id != Guid.Empty)
			{
				<MudMenu Label="View More Details" Color="Color.Primary" Variant="Variant.Filled">
					<MudMenuItem OnClick="@(ViewPatientDetails)">
						View Patient Details
					</MudMenuItem>
					<MudMenuItem OnClick="@(ViewConsultation)">
						View Consultation Details
					</MudMenuItem>
					<MudMenuItem OnClick="@(ViewAppointmentCard)">
						View Appointment Card
					</MudMenuItem>
				</MudMenu>
				<BootstrapButton Name="Cancel" Click="CancelAppointment" Type="@UiConstants.Bootstrap.Danger"
				                 Icon="fas fa-ban"/>
				<BootstrapButton Name="Delete" Click="() => DeleteAppointment(Id)" Type="@UiConstants.Bootstrap.Danger"
				                 Icon="fas fa-trash"/>

				@if (AppointmentData.IsSeries)
				{
					<BootstrapButton Name="Delete Series"
					                 Click="() => DeleteAppointmentSeries(AppointmentData.CustomRecurrenceId)"
					                 Type="@UiConstants.Bootstrap.Danger" Icon="fas fa-trash"/>
				}
			}
		</ActionButtons>
	</DexDialog>
}
else
{
	<DexProgressBar/>
}


@code {

	[CascadingParameter] public MudDialogInstance MudDialog { get; set; }
	[Parameter] public Guid Id { get; set; }
	[Parameter] public Guid HcpId { get; set; }
	[Parameter] public Guid SelectedPatientId { get; set; } = Guid.Empty;
	[Parameter] public DateTime StartDate { get; set; }
	[Parameter] public List<PatientListDto> PatientList { get; set; }
	[Parameter] public List<HealthcareDto> HealthCares { get; set; } = [];
	private UpsertAppointmentDto AppointmentData { get; set; } = new();
	private List<AppointmentTypeDto> AppointmentTypes { get; set; } = [];
	private List<ClinicSiteDto> ClinicSites { get; set; } = [];
	private List<UserClinic> Clinics { get; set; } = [];

	private string _title;
	private bool _processing;
	private bool _loadScreen;
	private string SelectedPatientName { get; set; }

	private DateTime MinDate { get; set; } = new(DateTime.Now.Year, DateTime.Now.Month, DateTime.Today.Day, 9, 00, 0);
	private DateTime MinTime { get; set; } = new(DateTime.Now.Year, DateTime.Now.Month, DateTime.Today.Day, 9, 00, 0);
	private DateTime MaxTime { get; set; } = new(DateTime.Now.Year, DateTime.Now.Month, DateTime.Today.Day, 17, 00, 0);

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await GetAppointmentTypes();
			await GetClinics();
		}
	}

	protected override async Task OnInitializedAsync()
	{
		_loadScreen = true;
		await Task.Delay(500);
		//For New Appointment
		if (Id == Guid.Empty)
		{
			_title = "New Appointment";
			AppointmentData.StartTime = StartDate;
			AppointmentData.HcpId = HcpId;
			AppointmentData.PatientId = SelectedPatientId;
			AppointmentData.PatientName = SelectedPatientName;
		await GetClinicSites(ApplicationState.Auth.CurrentUser.ClinicId);
			
		}
		else
		{
			_title = "Edit Appointment";
			var res = await UnitOfWork.Appointment.GetEditAppointment(Id);
			if (res.Succeeded)
			{
				AppointmentData = res.Data;
				SelectedPatientName = res.Data.PatientName;
				await GetClinicSites(AppointmentData.ClinicId);
			}
		}

		_loadScreen = false;
		StateHasChanged();
		MudDialog.StateHasChanged();
	}


	private async Task GetAppointmentTypes()
	{
		AppointmentTypes = await UnitOfWork.Setting.GetAppointmentTypes();
	}

	private async Task GetClinicSites(int clinicId)
	{
		ClinicSites = await UnitOfWork.Setting.GetSitesByClinic(clinicId);
	}

	private async Task GetClinics()
	{
		Clinics = await UnitOfWork.User.GetUserClinics(ApplicationState.Auth.CurrentUser.UserId);
	}

	private void ChangePatient(ChangeEventArgs<string, PatientListDto> args)
	{
		var patient = args.ItemData;
		if (patient != null)
		{
			AppointmentData.PatientId = patient.Id;
			AppointmentData.PatientName = patient.FullName;
			SelectedPatientName = patient.FullName;
			StateHasChanged();
		}
		else
		{
			AppointmentData.PatientId = Guid.Empty;
		}

		MudDialog.StateHasChanged();
	}


	private async Task OnClinicChanged(ChangeEventArgs<int, UserClinic> args)
	{
		var clinic = args.ItemData;
		if (clinic is not null)
		{
			await GetClinicSites(clinic.ClinicId);
		}
	}

	void OnAppointmentTypeChanged(ChangeEventArgs<Guid, AppointmentTypeDto> args)
	{
		var appointmentType = AppointmentTypes.FirstOrDefault(x => x.Id == args.Value);
		if (appointmentType is not null)
		{
			AppointmentData.AppointmentTypeId = appointmentType.Id;
			AppointmentData.Duration = appointmentType.Duration;
		}
	}

	private async Task SaveAppointment()
	{
		_processing = true;
		await Task.Delay(800);
		var res = await UnitOfWork.Appointment.SaveAppointment(Id, AppointmentData);
		if (res.Succeeded)
		{
			Snackbar.SuccessMessage(res.Messages.First());
			MudDialog.Close();
		}
		else
		{
			Snackbar.FailMessage(res.Messages.First());
		}

		_processing = false;
	}

	private async Task CancelAppointment()
	{
		var parameters = new DialogParameters {{"AppointmentId", Id}};
		var options = new DialogOptions() {CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true, Position = DialogPosition.Center};
		var dialogResult = await DialogService.ShowAsync<CancelAppointment>("", parameters, options);
		var result = await dialogResult.Result;
		if (!result.Canceled)
		{
			MudDialog.Close();
		}
	}

	private async Task DeleteAppointment(Guid id)
	{
		var parameters = new DialogParameters();
		var dialogresult = await DialogService.ShowAsync<DialogConfirm>("Confirm", parameters);
		var result = await dialogresult.Result;
		if (!result.Canceled)
		{
			await UnitOfWork.Appointment.DeleteAppointment(id);
			Snackbar.SuccessMessage("Appointment has been deleted.");

			MudDialog.Close();
		}
	}

	private async Task DeleteAppointmentSeries(Guid id)
	{
		var parameters = new DialogParameters {{"ContentText", "are you sure you want to delete series?"}};
		var dialogresult = await DialogService.ShowAsync<DialogConfirm>("Confirm", parameters);
		var result = await dialogresult.Result;
		if (!result.Canceled)
		{
			await UnitOfWork.Appointment.DeleteAppointmentSeries(id);
			Snackbar.SuccessMessage("Appointment series has been deleted.");
			MudDialog.Close();
		}
	}

	private void OnChange(ChangedEventArgs<DateTime> args)
	{
		AppointmentData.StartTime = args.Value;
		StateHasChanged();
	}

	private async Task ViewPatientDetails()
	{
		var parameters = new DialogParameters {{"PatientId", AppointmentData.PatientId}};
		var options = new DialogOptions() {CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true, Position = DialogPosition.Center};
		await DialogService.ShowAsync<PatientSummary>("", parameters, options);
	}

	private void ViewConsultation()
	{
		Snackbar.SuccessMessage("Consultation Not Selected");
	}

	private async Task ViewAppointmentCard()
	{
		var apptCard = new AppointmentCardDto()
		{
			StartTime = AppointmentData.StartTime,
			DoctorName = AppointmentData.DoctorName,
			PatientName = AppointmentData.PatientName,
			Location = AppointmentData.Location
		};
		var parameters = new DialogParameters {{"Appointment", apptCard}};
		var options = new DialogOptions() {CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true, Position = DialogPosition.Center};
		var dialogResult = await DialogService.ShowAsync<AppointmentCard>("", parameters, options);
		var result = await dialogResult.Result;
		if (!result.Canceled)
		{
		}
	}

}